<!DOCTYPE html>
<html lang="sv">
<head>
<style id="critical-split-clamps-v2">
/* Critical v2: prevent refresh flicker + prevent internal scroll */

/* Applies whenever #homeSplit exists (desktop and mobile) */
#homeSplit #mo,
#homeSplit #kenai-hub {
  overflow: hidden !important;
}

#homeSplit #mo p,
#homeSplit #mo li,
#homeSplit #kenai-hub p,
#homeSplit #kenai-hub li {
  overflow: hidden !important;
  display: -webkit-box !important;
  -webkit-box-orient: vertical !important;
}

@media (min-width: 800px) {

  #homeSplit .home-split-grid { align-items: stretch !important; }
  #homeSplit #mo,

  #homeSplit #mo .mo-panel {
    height: 100% !important;
    overflow: hidden !important;
    display: flex !important;
    flex-direction: column !important;
  }
  /* Desktop clamp */
  #homeSplit #mo p,
  #homeSplit #kenai-hub p { -webkit-line-clamp: 2 !important; }
  #homeSplit #mo li,
  #homeSplit #kenai-hub li { -webkit-line-clamp: 2 !important; }
}

@media (max-width: 799px) {
  /* Mobile: stacked, never lock heights */
  #homeSplit #mo,
  #homeSplit #kenai-hub {
    height: auto !important;
    overflow: visible !important;
  }
  /* Mobile clamp (a bit more room) */
  #homeSplit #mo p,
  #homeSplit #kenai-hub p { -webkit-line-clamp: 3 !important; }
  #homeSplit #mo li,
  #homeSplit #kenai-hub li { -webkit-line-clamp: 3 !important; }
}

/* mo-spacing-tune */
/* Goal: reduce vertical height inside both cards without changing layout logic */
#homeSplit #kenai-hub { padding: 22px 22px !important; }
#homeSplit #kenai-hub .tool-card { padding: 14px 14px !important; margin-bottom: 12px !important; }
#homeSplit #kenai-hub .tool-card h3,
#homeSplit #kenai-hub .tool-card h4 { margin: 6px 0 8px !important; }
#homeSplit #kenai-hub .tool-card p { margin: 0 0 10px !important; line-height: 1.25 !important; }
#homeSplit #kenai-hub .tool-card .btn,
#homeSplit #kenai-hub .tool-card button,
#homeSplit #kenai-hub .tool-card a.button { padding: 10px 14px !important; }

#homeSplit #mo .mo-panel { padding: 24px 26px !important; }
#homeSplit #mo .mo-wrap { gap: 12px !important; }
#homeSplit #mo p { line-height: 1.28 !important; margin: 0 0 10px !important; }
#homeSplit #mo ul { margin: 10px 0 12px !important; padding-left: 18px !important; }
#homeSplit #mo .mo-cta,
#homeSplit #mo button,
#homeSplit #mo a.button { margin-top: 10px !important; }
/* end mo-spacing-tune */



/* hub-edge-fix */
/* Removes thin white border/edge and focus outline artifacts in the Hub card(s) */
#kenai-hub, #kenai-hub * { -webkit-tap-highlight-color: rgba(0,0,0,0); }

#kenai-hub .hub-panel,
#kenai-hub .hub-card,
#kenai-hub .panel,
#kenai-hub .card,
#kenai-hub .glass,
#kenai-hub .kenai-card {
  border-color: rgba(255,255,255,0.04) !important; /* lower "white line" */
  outline: none !important;
  background-clip: padding-box;
  overflow: hidden; /* helps rounded + backdrop edges */
}

#kenai-hub .hub-panel:focus,
#kenai-hub .hub-panel:focus-within,
#kenai-hub .hub-card:focus,
#kenai-hub .hub-card:focus-within,
#kenai-hub .panel:focus,
#kenai-hub .panel:focus-within,
#kenai-hub .card:focus,
#kenai-hub .card:focus-within {
  outline: none !important;
  box-shadow: none !important; /* prevents "ring" looking like a border */
}
/* end hub-edge-fix */

</style>

<meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Kenai — Spela in. Sammanfatta. Dela.</title>
  <meta name="description" content="Spela in ljud, få AI-sammanfattning och dela direkt. Snabbt, enkelt och byggt för creators, poddar och möten.">

  <!-- Kenai favicon & app icons -->
  <link rel="icon" type="image/png" sizes="16x16" href="favicon-16x16 (1).png" />
  <link rel="icon" type="image/png" sizes="32x32" href="favicon-32x32 (1).png" />
  <link rel="icon" type="image/png" sizes="192x192" href="android-chrome-192x192 (1).png" />
  <link rel="icon" type="image/png" sizes="512x512" href="android-chrome-512x512 (2).png" />
  <link rel="apple-touch-icon" href="apple-touch-icon.png" />

  <!-- Brand info för Google -->
  <script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": "Kenai",
    "url": "https://kenai.technology",
    "logo": "https://kenai.technology/kenai-icon-512.png"
  }
  </script>

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: #f9fbff;
      background:
        linear-gradient(
          to bottom,
          rgba(3, 9, 24, 0.18),
          rgba(3, 9, 18, 0.78) 75%,
          rgba(3, 9, 18, 0.95)
        ),
        url("kenai-lake-mars.jpeg") center bottom / cover no-repeat;
      background-attachment: fixed;
    }

    .page {
      max-width: 1200px;
      margin: 0 auto;
      padding: 40px 16px 120px;
    }

    .hero {
      display: flex;
      flex-wrap: wrap;
      gap: 32px;
      align-items: flex-start;
      margin-bottom: 60px;
    }

    .hero-coin-wrap {
      flex: 0 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 24px;
    }

    .hero-coin {
      width: 240px;
      height: 240px;
      border-radius: 999px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: radial-gradient(circle at 30% 0%, #4ef1ff, #0070ff 55%, #050816);
      box-shadow:
        0 0 60px rgba(56, 189, 248, 0.85),
        0 0 120px rgba(59, 130, 246, 0.85);
      position: relative;
      overflow: hidden;
    }

    .hero-coin::after {
      content: "";
      position: absolute;
      inset: -40%;
      border-radius: inherit;
      background: conic-gradient(
        from 180deg,
        rgba(56, 189, 248, 0.0),
        rgba(56, 189, 248, 0.5),
        rgba(129, 140, 248, 0.0),
        rgba(236, 72, 153, 0.5),
        rgba(56, 189, 248, 0.0)
      );
      mix-blend-mode: screen;
      animation: spinGlow 14s linear infinite;
      pointer-events: none;
    }

    .hero-coin img {
      width: 82%;
      height: 82%;
      border-radius: 999px;
      object-fit: cover;
      position: relative;
      z-index: 1;
    }

    @keyframes spinGlow {
      from { transform: rotate(0deg); }
      to   { transform: rotate(360deg); }
    }

    .hero-copy {
      flex: 1 1 260px;
      max-width: 560px;
    }

    .hero-eyebrow {
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #a5b4fc;
      margin-bottom: 10px;
    }

    .hero-title {
      font-size: 42px;
      line-height: 1.12;
      letter-spacing: 0.06em;
      font-weight: 700;
      text-transform: uppercase;
      margin-bottom: 18px;
      text-shadow: 0 10px 30px rgba(15, 23, 42, 0.9);
    }

    .hero-title span { display: block; }

    .hero-lead {
      font-size: 14px;
      line-height: 1.7;
      max-width: 420px;
      color: #e5edff;
      margin-bottom: 26px;
    }

    .hero-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
    }

    .kenai-btn {
      padding: 11px 22px;
      border-radius: 999px;
      border: none;
      cursor: pointer;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      transition: transform 0.16s ease, box-shadow 0.16s ease, filter 0.16s ease;
      white-space: nowrap;
    }

    .kenai-btn-primary {
      background: linear-gradient(135deg, #22c55e, #4ade80);
      color: #02101f;
      box-shadow: 0 14px 40px rgba(22, 163, 74, 0.65);
    }

    .kenai-btn-secondary {
      background: linear-gradient(135deg, #3b82f6, #a855f7);
      color: #f9fbff;
      box-shadow: 0 14px 40px rgba(59, 130, 246, 0.7);
    }

    .kenai-btn:hover {
      transform: translateY(-2px) scale(1.02);
      filter: brightness(1.06);
      box-shadow: 0 18px 55px rgba(0, 0, 0, 0.65);
    }

    /* HUB */
    #kenai-hub { padding-top: 10px; }

    .hub-layout {
      display: flex;
      flex-wrap: wrap;
      gap: 32px;
      align-items: flex-start;
    }

    .hub-card {
      flex: 1 1 320px;
      max-width: 420px;
      background: rgba(3, 12, 40, 0.92);
      border-radius: 32px;
      padding: 24px 20px 24px;
      box-shadow: 0 22px 60px rgba(0, 0, 0, 0.7);
      border: 1px solid rgba(110, 207, 255, 0.35);
      backdrop-filter: blur(18px);
    }

    .hub-header {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 14px;
    }

    .hub-icon {
      width: 40px;
      height: 40px;
      border-radius: 999px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: radial-gradient(circle at 30% 0%, #4ef1ff, #0070ff 55%, #050816 100%);
      box-shadow: 0 0 22px rgba(78, 241, 255, 0.65);
      flex: 0 0 auto;
    }

    .hub-icon img {
      width: 26px;
      height: 26px;
      border-radius: 999px;
      object-fit: cover;
    }

    .hub-kicker {
      font-size: 11px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #7ddcff;
      margin-bottom: 4px;
    }

    .hub-title {
      font-size: 17px;
      font-weight: 600;
      color: #f9fbff;
      line-height: 1.2;
    }

    .hub-intro {
      font-size: 13px;
      line-height: 1.6;
      color: #c4d3ff;
      margin-bottom: 14px;
    }

    .hub-trust {
      font-size: 12px;
      color: rgba(255,255,255,0.78);
      opacity: 0.92;
      margin-bottom: 16px;
    }

    .hub-tools {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .tool-card {
      border-radius: 18px;
      padding: 12px 12px 12px;
    }

    .tool-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      margin-bottom: 6px;
    }

    .tool-pill {
      font-size: 11px;
      padding: 2px 7px;
      border-radius: 999px;
      border-width: 1px;
      border-style: solid;
      display: inline-block;
    }

    .tool-name {
      font-size: 13px;
      font-weight: 600;
      margin-left: 6px;
      display: inline-block;
    }

    .tool-desc {
      font-size: 12px;
      color: #c9ddff;
      margin-bottom: 10px;
    }

    .tool-btn {
      width: 100%;
      font-size: 12px;
      padding: 7px 10px;
      border-radius: 999px;
      border: none;
      cursor: pointer;
      font-weight: 600;
      transition: transform 0.16s ease, box-shadow 0.16s ease, filter 0.16s ease;
    }

    .tool-btn:hover {
      transform: translateY(-2px) scale(1.01);
      filter: brightness(1.05);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
    }

    /* Tool colors */
    .tool-recorder {
      background: linear-gradient(135deg, rgba(0, 255, 179, 0.08), rgba(0, 114, 255, 0.06));
      border: 1px solid rgba(94, 234, 212, 0.35);
    }
    .tool-recorder .tool-pill {
      background: rgba(6, 182, 212, 0.18);
      color: #7deaff;
      border-color: rgba(125, 234, 255, 0.4);
    }
    .tool-recorder .tool-name { color: #e8f4ff; }
    .tool-recorder .tool-btn {
      background: linear-gradient(135deg, #22c55e, #4ade80);
      color: #02101f;
      box-shadow: 0 10px 30px rgba(16, 185, 129, 0.5);
    }

    .tool-timestamps {
      background: linear-gradient(135deg, rgba(56, 189, 248, 0.08), rgba(129, 140, 248, 0.08));
      border: 1px solid rgba(96, 165, 250, 0.35);
    }
    .tool-timestamps .tool-pill {
      background: rgba(59, 130, 246, 0.18);
      color: #bfdbfe;
      border-color: rgba(191, 219, 254, 0.4);
    }
    .tool-timestamps .tool-name { color: #e8f4ff; }
    .tool-timestamps .tool-btn {
      background: linear-gradient(135deg, #3b82f6, #8b5cf6);
      color: #f9fbff;
      box-shadow: 0 10px 30px rgba(59, 130, 246, 0.5);
    }

    .tool-reels {
      background: linear-gradient(135deg, rgba(249, 115, 22, 0.12), rgba(236, 72, 153, 0.12));
      border: 1px solid rgba(251, 146, 60, 0.45);
    }
    .tool-reels .tool-pill {
      background: rgba(248, 113, 113, 0.18);
      color: #fed7aa;
      border-color: rgba(248, 187, 131, 0.5);
    }
    .tool-reels .tool-name { color: #fee2e2; }
    .tool-reels .tool-btn {
      background: linear-gradient(135deg, #fb923c, #ec4899);
      color: #0b0410;
      font-weight: 700;
      box-shadow: 0 10px 32px rgba(236, 72, 153, 0.6);
    }

    @media (max-width: 768px) {
      .page { padding: 24px 14px 80px; }
      .hero { justify-content: center; text-align: center; }
      .hero-copy { align-items: center; display: flex; flex-direction: column; }
      .hero-lead { max-width: none; }
      .hero-buttons { justify-content: center; }
      .hub-card { margin: 0 auto; }
      body { background-attachment: scroll; }
    }
  /* ==== Button micro-anim ==== */
.kenai-btn,.tool-btn{position:relative;will-change:transform,filter,box-shadow}
.kenai-btn:active,.tool-btn:active{transform:scale(.985)}
.kenai-btn:focus-visible,.tool-btn:focus-visible{outline:none;box-shadow:0 0 0 3px rgba(125,234,255,.45)}
.kenai-btn::after,.tool-btn::after{content:"";position:absolute;inset:0;border-radius:inherit;background:linear-gradient(120deg,rgba(255,255,255,0) 0%,rgba(255,255,255,.12) 35%,rgba(255,255,255,0) 70%);transform:translateX(-120%);transition:transform .45s ease;pointer-events:none}
.kenai-btn:hover::after,.tool-btn:hover::after{transform:translateX(120%)}


/* split-height cap css */

/* mo-scroll-fix */

#homeSplit #mo .mo-panel { max-height: 100% !important; }
#homeSplit #kenai-hub { overflow: auto !important; scrollbar-gutter: stable both-edges; min-height: 0 !important; }
#homeSplit #mo .mo-panel { overflow: auto !important; padding-bottom: 22px !important; scrollbar-gutter: stable both-edges; min-height: 0 !important; overscroll-behavior: contain; }
</style>

<style id="mo-section-css">  /* --- MO layout: side-by-side earlier (most desktops), stacked only on small screens --- */
  @media (min-width: 600px) {
    #mo .mo-wrap {
      display: flex !important;
      align-items: flex-start;
      gap: 32px;
      text-align: left;
      justify-content: flex-start;
    }
    #mo .mo-icon { flex: 0 0 220px; }
    #mo .mo-content { flex: 1 1 auto; min-width: 0; }
  }

  @media (max-width: 599px) {
    #mo .mo-wrap {
      display: grid !important;
      grid-template-columns: 1fr;
      text-align: center;
      place-items: center;
      gap: 18px;
    }
    #mo .mo-icon { width: clamp(120px, 10vw, 160px); }
  }

  /* --- MO layout: desktop side-by-side, mobile stacked --- */
  .mo-wrap { width: 100%; }

  .mo-icon { width: clamp(120px, 10vw, 160px); }
  }

  /* --- MO section (homepage) --- */
  .mo-section {
    position: relative;
    padding: clamp(56px, 6vw, 96px) 0;
  }

  /* Subtle "core panel" that feels deeper than the page background */
  .mo-panel {
    position: relative;
    border-radius: 24px;
    padding: clamp(32px, 4vw, 56px);
    overflow: hidden;
    background:
      radial-gradient(800px 400px at 50% 18%, rgba(0, 225, 255, 0.10), rgba(0, 0, 0, 0) 60%),
      linear-gradient(180deg, rgba(0,0,0,0.55), rgba(0,0,0,0.70));
    border: 1px solid rgba(255,255,255,0.06);
    box-shadow:
      0 24px 80px rgba(0,0,0,0.45),
      inset 0 1px 0 rgba(255,255,255,0.03);
  }

  

  .mo-wrap {
    position: relative;
    display: grid;
    gap: 32px;
    max-width: 1100px;
    margin: 0 auto;
    align-items: flex-start;
  }

  /* Desktop: side-by-side */
  /* Mobile: stacked */
  .mo-panel::before {
    content: "";
    position: absolute;
    inset: -2px;
    background: radial-gradient(500px 260px at 50% 0%, rgba(0, 225, 255, 0.12), rgba(0,0,0,0) 70%);
    pointer-events: none;
    opacity: 0.7;
  }

  
  @media (min-width: 900px) {
    }

  @media (max-width: 899px) {
    }

  /* Icon: symmetric AI-core */
  .mo-icon {
    width: clamp(120px, 10vw, 160px);
    height: auto;
    filter: drop-shadow(0 0 14px rgba(0, 225, 255, 0.20));
  }

  .mo-core-ring {
    stroke: rgba(0, 225, 255, 0.85);
    stroke-width: 3;
  }

  .mo-core-dot {
    fill: rgba(0, 225, 255, 0.95);
  }

  /* Bas-puls: always on, almost unnoticeable */
  .mo-core-pulse {
    animation: moPulseBase 4.6s ease-in-out infinite;
    transform-origin: 50% 50%;
  }

  @keyframes moPulseBase {
    0%, 100% { opacity: 0.70; transform: scale(1.00); }
    50%      { opacity: 1.00; transform: scale(1.06); }
  }

  /* Hover / activate: short stronger ring + faster dot once */
  .mo-panel:hover .mo-core-ring,
  .mo-panel:focus-within .mo-core-ring {
    animation: moRingBoost 900ms ease-out 1;
  }

  @keyframes moRingBoost {
    0%   { opacity: 0.75; filter: drop-shadow(0 0 0 rgba(0, 225, 255, 0)); }
    35%  { opacity: 1.00; filter: drop-shadow(0 0 18px rgba(0, 225, 255, 0.35)); }
    100% { opacity: 0.90; filter: drop-shadow(0 0 0 rgba(0, 225, 255, 0)); }
  }

  .mo-panel:hover .mo-core-dot,
  .mo-panel:focus-within .mo-core-dot {
    animation: moDotBoost 700ms ease-in-out 1;
    transform-origin: 50% 50%;
  }

  @keyframes moDotBoost {
    0%   { transform: scale(1.00); opacity: 0.95; }
    45%  { transform: scale(1.28); opacity: 1.00; }
    100% { transform: scale(1.00); opacity: 0.95; }
  }

  .mo-title {
    margin: 6px 0 0;
    font-size: clamp(42px, 5vw, 64px);
    line-height: 1.0;
    letter-spacing: -0.02em;
    color: rgba(255,255,255,0.98); /* solid white */
  }

  .mo-subtitle {
    margin: 0;
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.5;
    color: rgba(255,255,255,0.86);
    max-width: 46ch;
  }

  .mo-body {
    margin-top: 10px;
    display: grid;
    gap: 12px;
    color: rgba(255,255,255,0.80);
    font-size: 16px;
    line-height: 1.65;
    max-width: 62ch;
  }

  .mo-list {
    margin: 10px auto 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 8px;
    max-width: 62ch;
    color: rgba(255,255,255,0.82);
  }

  .mo-list li {
    padding-left: 16px;
    position: relative;
  }

  .mo-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: rgba(0, 225, 255, 0.85);
    box-shadow: 0 0 10px rgba(0, 225, 255, 0.20);
  }

  .mo-cta {
    margin-top: 16px;
    display: inline-flex;
    gap: 10px;
    align-items: center;
    justify-content: center;
    padding: 10px 14px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.10);
    background: rgba(255,255,255,0.04);
    color: rgba(255,255,255,0.92);
    text-decoration: none;
    transition: transform 160ms ease, background 160ms ease, border-color 160ms ease;
  }

  .mo-cta:hover {
    transform: translateY(-1px);
    background: rgba(255,255,255,0.06);
    border-color: rgba(255,255,255,0.14);
  }

  .mo-footnote {
    margin-top: 10px;
    font-size: 13px;
    color: rgba(255,255,255,0.62);
  }

@media (min-width: 600px) { #mo .mo-icon { margin-top: 6px; } }

/* split-typography */
@media (min-width: 800px) {
  #homeSplit #mo .mo-panel { padding: 34px 36px; }
  #homeSplit #mo .mo-wrap { gap: 22px; align-items: flex-start; }

  #homeSplit #mo .mo-content { text-align: left; min-width: 0; }
  #homeSplit #mo .mo-title { font-size: clamp(34px, 3.2vw, 48px); line-height: 1.05; }
  #homeSplit #mo .mo-subtitle { font-size: 16px; line-height: 1.35; opacity: 0.9; }

  #homeSplit #mo .mo-body {
  max-width: 56ch;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
  #homeSplit #mo .mo-body p { font-size: 15px; line-height: 1.55; }
  #homeSplit #mo .mo-bullets {
  font-size: 14px;
  line-height: 1.5;
  margin-top: 10px !important;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
  #homeSplit #mo .mo-cta { margin-top: 14px; }
}

/* CLEAN SPLIT LAYOUT */
@media (min-width: 900px) {
  #homeSplit #mo .mo-wrap {
    display: grid !important;
    grid-template-columns: 180px 1fr;
    gap: 32px;
    align-items: start;
  }

  #homeSplit #mo .mo-icon {
    width: 180px;
  }

  #homeSplit #mo .mo-content {
    text-align: left;
    max-width: 620px;
  }

  #homeSplit #mo .mo-title {
    font-size: 42px;
    line-height: 1.1;
  }

  #homeSplit #mo .mo-body p {
    font-size: 16px;
    line-height: 1.6;
  }
}

/* === MO SYMMETRIC TO HUB (override) === */
@media (min-width: 900px) {
  /* Ensure split columns stretch equally */
  #homeSplit .home-split-grid { align-items: stretch; }

  /* Make MO card behave like a normal single-column card */
  #homeSplit #mo .mo-panel { height: 100%; }
  #homeSplit #mo .mo-wrap {
    display: block !important;
    text-align: left !important;
  }

  /* Icon top, centered-ish like a hero badge */
  #homeSplit #mo .mo-icon {
    display: block !important;
    width: 140px !important;
    margin: 6px auto 18px auto !important;
  }

  /* Content uses full card width (no skinny column) */
  #homeSplit #mo .mo-content {
    width: 100% !important;
    max-width: none !important;
    text-align: left !important;
  }

  /* Typography similar to Hub card */
  #homeSplit #mo .mo-title {
    font-size: 32px !important;
    line-height: 1.1 !important;
    margin: 0 0 8px 0 !important;
  }
  #homeSplit #mo .mo-subtitle {
    font-size: 16px !important;
    line-height: 1.4 !important;
    opacity: 0.92 !important;
    margin: 0 0 14px 0 !important;
  }
  #homeSplit #mo .mo-body {
  max-width: 56ch;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
  #homeSplit #mo .mo-body p {
    font-size: 15px !important;
    line-height: 1.6 !important;
    margin: 0 0 10px 0 !important;
  }
  #homeSplit #mo .mo-bullets {
  font-size: 14px;
  line-height: 1.5;
  margin-top: 10px !important;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
  #homeSplit #mo .mo-cta { margin-top: 14px !important; }
}

/* === MO MATCH HUB HEIGHT === */
@media (min-width: 900px) {
  /* Make the split row stretch both cards equally */
  #homeSplit .home-split-grid { align-items: stretch !important; }
  #homeSplit #kenai-hub { height: 100%; }
  #homeSplit #mo { height: 100%; }

  /* Ensure MO panel fills the column height */
  #homeSplit #mo .mo-panel {
    height: 100% !important;
    display: flex !important;
    flex-direction: column !important;
  }

  /* Make content area stretch so CTA sits lower like Hub */
  #homeSplit #mo .mo-content {
    flex: 1 1 auto !important;
    display: flex !important;
    flex-direction: column !important;
  }

  /* Push CTA towards bottom for symmetry */
  #homeSplit #mo .mo-cta { margin-top: auto !important; }

  /* If still shorter, enforce a minimum comparable height */
  #homeSplit #mo .mo-panel { }
}

</style>
<style id="home-split-css">
#homeSplit { padding: 32px 0; }
#homeSplit .home-split-grid {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
  display: grid;
  grid-template-columns: 1fr;
  gap: 28px;
  align-items: start;
}
@media (min-width: 800px) {
  #homeSplit .home-split-grid {
    grid-template-columns: 1.15fr 0.85fr;
  }
}
#homeSplit #kenai-hub,
#homeSplit #mo {
  margin: 0 !important;
}

/* split-clamp-v1 (keep MO same height as Hub on desktop) */
@media (min-width: 800px) {
  #homeSplit #mo .mo-panel { padding-bottom: 18px !important; }
  #homeSplit #mo .mo-body p{
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    overflow: hidden;
  }
  #homeSplit #mo .mo-bullets{
  font-size: 14px;
  line-height: 1.5;
  margin-top: 10px !important;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
  #homeSplit #mo .mo-cta{ margin-top: 12px !important; }
}

/* mobile-split */
@media (max-width: 799px) {
  /* Stack: Hub then MO */
  #homeSplit .home-split-grid {
    grid-template-columns: 1fr !important;
    gap: 16px !important;
    align-items: start !important;
  }

  /* Remove forced equal height on mobile */
  #homeSplit { --split-h: auto !important; }
  #homeSplit #kenai-hub,
  #homeSplit #mo {
    height: auto !important;
    min-height: 0 !important;
    overflow: visible !important;
  }

  /* Make MO readable + centered without squeezing */
  #homeSplit #mo .mo-panel {
    height: auto !important;
    min-height: 0 !important;
    padding: 22px 18px !important;
  }
  #homeSplit #mo .mo-wrap {
    gap: 14px !important;
    align-items: center !important;
  }
  #homeSplit #mo .mo-content {
    text-align: left !important;
    max-width: 60ch !important;
  }

  /* Tone down huge desktop title on small screens */
  #homeSplit #mo .mo-title {
    font-size: 34px !important;
    line-height: 1.05 !important;
  }
}
/* end mobile-split */

/* mobile-stack-fix */
@media (max-width: 799px) {
  /* Kill fixed split-height behavior on phones */
  #homeSplit { --split-h: auto !important; }
  #homeSplit #kenai-hub { height: auto !important; }
  #homeSplit #mo { height: auto !important; }
  #homeSplit #mo .mo-panel { height: auto !important; min-height: 0 !important; }

  /* Force normal document flow stacking (Hub then MO) */
  #homeSplit .home-split-grid { display: block !important; }
  #homeSplit #mo { margin-top: 22px !important; }

  /* Avoid any leftover “push-down” spacing */
  #homeSplit #kenai-hub { margin-bottom: 0 !important; }
}
/* end mobile-stack-fix */

/* desktop-split-sync */
@media (min-width: 800px) {
  /* Exact same height for both cards (Hub -> drives --split-h via JS) */
  #homeSplit { --split-h: auto; }

  /* Stop clipping inside MO card */
  #homeSplit #mo .mo-panel { overflow: hidden !important; }

  /* Make MO text area scroll if it would clip */
  #homeSplit #mo .mo-content { min-width: 0; }
  #homeSplit #mo .mo-body {
    overflow: auto !important;
    padding-bottom: 18px !important;
    max-height: none !important;
  }

  /* If line-clamp exists, neutralize it on desktop so last lines are readable */
  #homeSplit #mo .mo-body,
  #homeSplit #mo .mo-body p,
  #homeSplit #mo .mo-bullets {
    -webkit-line-clamp: unset !important;
    line-clamp: unset !important;
    display: block !important;
  }
}
/* end desktop-split-sync */

/* split-stable-v1 */
/* Desktop split: equal-height cards, no inner scroll, no refresh flicker */
#homeSplit .home-split-grid{
  display:grid !important;
  grid-template-columns: 1fr 1fr !important;
  gap: 22px !important;
  align-items: stretch !important;
}

/* Ensure both cards stretch to same row height */
#homeSplit #kenai-hub,
#homeSplit #mo{
  height: auto !important;
}

/* Hub card: prevent inner scrollbars */
#homeSplit #kenai-hub{
  overflow: hidden !important;
}

/* MO card: flex column so CTA can sit at bottom, without forcing a tall fixed height */
#homeSplit #mo .mo-panel{
  height: 100% !important;
  display: flex !important;
  flex-direction: column !important;
  overflow: hidden !important;
  padding-bottom: 18px !important;
}
#homeSplit #mo .mo-cta{
  margin-top: auto !important;
}

/* Clamp text consistently (prevents "sometimes one more line" on refresh) */
#homeSplit #mo .mo-subtitle{
  display: -webkit-box !important;
  -webkit-box-orient: vertical !important;
  -webkit-line-clamp: 1 !important;
  overflow: hidden !important;
}
#homeSplit #mo .mo-body{
  display: -webkit-box !important;
  -webkit-box-orient: vertical !important;
  -webkit-line-clamp: 3 !important;
  overflow: hidden !important;
}
#homeSplit #mo .mo-bullets{
  display: -webkit-box !important;
  -webkit-box-orient: vertical !important;
  -webkit-line-clamp: 2 !important;
  overflow: hidden !important;
}

/* Mobile: stack, and ensure MO does NOT end up far down */
@media (max-width: 900px){
  #homeSplit .home-split-grid{
    grid-template-columns: 1fr !important;
  }
  #homeSplit #mo{
    margin-top: 14px !important;
  }
}
/* end split-stable-v1 */

/* mo-scroll-shadow-fix */
#homeSplit #kenai-hub{
  /* Kill asymmetric/right-heavy shadow and prevent inner scrolling */
  box-shadow: 0 18px 60px rgba(0,0,0,.45) !important;
  overflow: hidden !important;
}

#homeSplit #mo{
  /* Never become a scroll container that steals wheel scroll */
  overflow: hidden !important;
}

#homeSplit #mo .mo-panel,
#homeSplit #mo .mo-content,
#homeSplit #mo .mo-body{
  overflow: hidden !important;
  overscroll-behavior: auto !important;
}
/* end mo-scroll-shadow-fix */

</style>
</head>

<body>
  <div class="page">
    <!-- HERO -->
    <header class="hero">
      <div class="hero-coin-wrap">
        <div class="hero-coin">
          <img id="kenaiLogo" src="kenai-coin-main.jpg" alt="Kenai logga">
        </div>
      </div>

      <div class="hero-copy">
        <h1 class="hero-title">
  <span>Hands-free AI</span>
  <span>Ask. Get the answer. Done.</span>
</h1>
        <p class="hero-lead">
          Voice-first tools built for speed, focus and flow.
        </p>
        <div class="hero-buttons">
          <button class="kenai-btn kenai-btn-primary" onclick="window.location.href='https://app.kenai.technology/recorder.html'">
            Try Mo
          </button>
          <button class="kenai-btn kenai-btn-secondary" onclick="window.location.href='https://app.kenai.technology/reels.html'">
            Explore Kenai
          </button>
        </div>
      </div>
    </header>

    <!-- KENAI HUB -->
    <section id="homeSplit">
  <div class="home-split-grid">
    <div class="home-left">
<section id="kenai-hub">
      <div class="hub-layout">
        <div class="hub-card">
          <div class="hub-header">
            <div class="hub-icon">
              <img src="kenai-coin-main.jpg" alt="Kenai-logga" />
            </div>
            <div>
              <div class="hub-kicker">AI-verktyg för creators</div>
              <div class="hub-title">Skapa content med AI – på sekunder</div>
            </div>
          </div>

          <p class="hub-intro">
            Spela in ljud, få sammanfattningar och skapa reels – utan inloggning, utan krångel.
          </p>

          <div class="hub-trust">✓ Ingen inloggning &nbsp;&nbsp; ✓ Funkar direkt i webben &nbsp;&nbsp; ✓ Byggd för creators</div>

          <div class="hub-tools">
            <!-- Recorder -->
            <div class="tool-card tool-recorder">
              <div class="tool-header">
                <div>
                  <span class="tool-pill">Recorder</span>
                  <span class="tool-name">Spela in &amp; AI-sammanfattning</span>
                </div>
              </div>
              <p class="tool-desc">
                Spela in direkt i browsern, ladda upp till Kenai och få en tydlig AI-sammanfattning av vad du sagt – perfekt för möten, poddar &amp; idéer.
              </p>
              <button class="tool-btn" onclick="window.location.href='https://app.kenai.technology/recorder.html'">
                Öppna Kenai Recorder
              </button>
            </div>

            <!-- Timestamps -->
            <div class="tool-card tool-timestamps">
              <div class="tool-header">
                <div>
                  <span class="tool-pill">Timestamps</span>
                  <span class="tool-name">YouTube timestamps &amp; beskrivning</span>
                </div>
              </div>
              <p class="tool-desc">
                Klistra in en YouTube- eller podd-URL. Kenai hjälper dig få kapitel, sammanfattning och text du kan klistra in direkt i beskrivningen.
              </p>
              <button class="tool-btn" onclick="window.location.href='https://app.kenai.technology/timestamps.html'">
                Öppna Kenai Timestamps
              </button>
            </div>

            <!-- Reels -->
            <div class="tool-card tool-reels">
              <div class="tool-header">
                <div>
                  <span class="tool-pill">Reels</span>
                  <span class="tool-name">Planera &amp; bygg dina reels</span>
                </div>
              </div>
              <p class="tool-desc">
                Ladda upp bilder &amp; klipp, välj längd och låt Kenai hjälpa dig planera en short/reel – med AI-idéer och hashtags på vägen.
              </p>
              <button class="tool-btn" onclick="window.location.href='https://app.kenai.technology/reels.html'">
                Öppna Kenai Reels Maker
              </button>
            </div>
          </div>
        </div>

        <!-- Spacer: keep background visible -->
        
      </div>
    </section>
    <!-- /KENAI HUB -->
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const logo = document.getElementById('kenaiLogo');
      if (logo) {
        logo.style.cursor = 'pointer';
        logo.addEventListener('click', () => window.location.reload());
      }
    });
  </script>
<section id="mo" class="mo-section">
  <div class="mo-panel">
    <div class="mo-wrap">
      <svg class="mo-icon" viewBox="0 0 200 200" role="img" aria-label="MO core">
        <circle cx="100" cy="100" r="74" fill="none" class="mo-core-ring"/>
        <g class="mo-core-pulse">
          <circle cx="100" cy="100" r="8" class="mo-core-dot"/>
        </g>
        <!-- subtle symmetric signal lines -->
        <g opacity="0.55" stroke="rgba(0,225,255,0.75)" stroke-width="2" stroke-linecap="round">
          <line x1="100" y1="26" x2="100" y2="40"/>
          <line x1="26" y1="100" x2="40" y2="100"/>
          <line x1="160" y1="100" x2="174" y2="100"/>
        </g>
      </svg>

      <div class="mo-content">
      <h2 class="mo-title">MO</h2>
      <p class="mo-subtitle">När du är upptagen – men behöver svar.</p>

      <div class="mo-body">
        <p>
          MO är en hands-free AI för stunder när du inte kan ta upp mobilen.
          Via hörlurar eller knapp aktiverar du MO direkt.
        </p>
        <p>
          Istället för att öppna webben, skriva en sökning och skrolla länkar – säger du bara frågan.
          MO ger ett koncentrerat, handlingsbart svar direkt i dina hörlurar.
        </p>
      </div>

      <ul class="mo-list">
        <li>Byggd för fokus: korta sessioner, tydliga svar.</li>
        <li>Ingen distraktion, ingen oändlig dialog.</li>
        <li>Prata. Få svar. Fortsätt.</li>
      </ul>

      <a class="mo-cta" href="#tools" aria-label="Gå till verktyg">Utforska Kenai</a>

      
      <div class="mo-footnote">Detta är början.</div>
    </div>
  </div>
</section>
    </div>
    
  </div>
</section>

<!-- split-height-sync -->
<script>
(function() {
  function syncSplitHeight() {
    try {
      var root = document.getElementById('homeSplit');
      if (!root) return;

      // Only on desktop split layout
      var isDesktop = window.matchMedia && window.matchMedia('(min-width: 800px)').matches;
      if (!isDesktop) {
        root.style.removeProperty('--split-h');
        return;
      }

      var hub = document.getElementById('kenai-hub');
      if (!hub) return;

      // Use rendered height of hub card
      var h = Math.ceil(hub.getBoundingClientRect().height);
      if (h > 0) /* split-height cap */
  (function(){
    var __val = h + 'px';
    var __num = parseInt(String(__val).replace(/[^0-9]/g,''), 10);
    var __cap = 520;
    if (window.innerWidth <= 420) __cap = 480;  // phones
    if (!isNaN(__num) && __num > 0) {
      var __final = Math.min(__num, __cap);
      root.style.setProperty('--split-h', __final + 'px');
      root.style.setProperty('--split-cap', __cap + 'px');
    }
  })();
} catch (e) {}
  }

  var t = null;
  function schedule() {
    if (t) clearTimeout(t);
    t = setTimeout(syncSplitHeight, 50);
  }

  window.addEventListener('load', function() { schedule(); setTimeout(syncSplitHeight, 250); });
  window.addEventListener('resize', schedule);

  // run once immediately in case DOM is already ready
  schedule();
})();
</script>
<!-- end split-height-sync -->
</body>
</html>

<!-- Ken ai header -->
<header class="kenai-top">
  <div class="kenai-brand">Ken ai</div>
  <div class="kenai-sub">tools</div>
</header>

<style>
  .kenai-top{display:flex;align-items:baseline;gap:10px;margin:14px 0 10px}
  .kenai-brand{font-weight:800;letter-spacing:.2px;font-size:22px}
  .kenai-sub{opacity:.75;font-size:14px}
</style>

